# HawkEye Backend Configuration
# ================================

# Database (SQLite for development, swap to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./hawkeye.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hawkeye

# JWT Settings — Access Token
SECRET_KEY=hawkeye-super-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT Settings — Refresh Token
REFRESH_SECRET_KEY=hawkeye-refresh-secret-key-change-in-production-2024
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_DIGIT=true

# Rate Limiting
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SCAN=5/minute
RATE_LIMIT_DEFAULT=60/minute

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# App Settings
APP_NAME=HawkEye
APP_VERSION=1.0.0
DEBUG=true

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
